"""
Install {{ title }} @VERSION@ on this computer: Linux, macOS or Windows.

Download this file and the package next to it from {{ cloud_name }}
(Settings -> Edges -> Install an edge), then, in that folder:

    python3 install_{{ package_name }}.py        (Linux, macOS)
    py install_{{ package_name }}.py             (Windows)

It needs Python 3.10 or newer, nothing else, and does no more than:
  1. checks the package against the SHA-256 {{ cloud_name }} published
  2. makes a virtualenv in this user's own application-data folder and
     installs the package there (no administrator rights)
  3. writes two start commands (.cmd on Windows) and starts the first:
       {{ tool_name }}-start       http://127.0.0.1:{{ port }}, this computer only
       {{ tool_name }}-start-lan   this computer and its network: other
                                 computers open the page; the chat needs its key
     ({{ env_prefix }}_EDGE_LAN=1 starts the second one now). Each stops a running
     edge first, so switching is running the other one.
On its first start the edge fetches what it still lacks; after linking,
what its {{ tenant_noun }} already knows. Running this again updates the edge.

Without this script, the same by hand:
    python -m venv <folder>/venv
    <folder>/venv/bin/python -m pip install @WHEEL@
    <folder>/venv/bin/python -m {{ package_name }}     ({{ env_prefix }}_EDGE_HOME=<folder> to keep its files there)

Generated by scripts/publish-to-cloud.sh; do not edit the copy in the cloud.
"""

import hashlib
import os
import subprocess
import sys
import time
import urllib.request
import venv
import webbrowser
from pathlib import Path

VERSION = "@VERSION@"
WHEEL = "@WHEEL@"
SHA256 = "@SHA256@"
PORT = int(os.environ.get("{{ env_prefix }}_EDGE_PORT", "{{ port }}"))
LAN = os.environ.get("{{ env_prefix }}_EDGE_LAN", "").strip().lower() in ("1", "yes", "true")
WHERE = "this computer and its network" if LAN else "this computer only"


def say(text=""):
    print(text, flush=True)


def stop(text):
    say("")
    say("  x " + text)
    sys.exit(1)


def data_home():
    if sys.platform == "win32":
        return Path(os.environ.get("LOCALAPPDATA") or Path.home() / "AppData" / "Local") / "{{ tool_name }}"
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support" / "{{ tool_name }}"
    return Path(os.environ.get("XDG_DATA_HOME") or Path.home() / ".local" / "share") / "{{ tool_name }}"


def running():
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/api/health", timeout=2):
            return True
    except Exception:
        return False


def main():
    say(f"{{ title }} {VERSION}")
    if sys.version_info < (3, 10):
        stop(f"Python 3.10 or newer is needed (this is {sys.version.split()[0]}): https://www.python.org/downloads/")
    say(f"  ok Python {sys.version.split()[0]}")

    pkg = Path(__file__).resolve().parent / WHEEL
    if not pkg.is_file():
        stop(f"{WHEEL} must be next to this script: download both from {{ cloud_name }}.")
    if hashlib.sha256(pkg.read_bytes()).hexdigest() != SHA256:
        stop(f"{WHEEL} does not match its checksum. Download it again from {{ cloud_name }}.")
    say("  ok package checked (SHA-256)")

    home = Path(os.environ["{{ env_prefix }}_EDGE_HOME"]) if os.environ.get("{{ env_prefix }}_EDGE_HOME") else data_home()
    home.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(home, 0o700)
    except OSError:
        pass
    env_dir = home / "venv"
    py = env_dir / ("Scripts/python.exe" if sys.platform == "win32" else "bin/python")
    if not py.exists():
        venv.EnvBuilder(with_pip=True).create(env_dir)
    clean = {k: v for k, v in os.environ.items() if k != "PYTHONPATH"}
    say("  .. installing (the first time this downloads its libraries, a few minutes)")
    subprocess.run([str(py), "-m", "pip", "install", "--quiet", "--upgrade", "pip"], check=True, env=clean)
    subprocess.run([str(py), "-m", "pip", "install", "--quiet", "--upgrade", "--force-reinstall", "--no-deps", str(pkg)], check=True, env=clean)
    subprocess.run([str(py), "-m", "pip", "install", "--quiet", str(pkg)], check=True, env=clean)
    say(f"  ok installed in {home}")

    # two start commands; each stops a running edge first (a restart from
    # the page would keep the old mode), so switching is running the other
    starts = {}
    for mode, flag in (("", ""), ("-lan", "--lan ")):
        if sys.platform == "win32":
            path = home / f"{{ tool_name }}-start{mode}.cmd"
            path.write_text(f'@echo off\r\nset PYTHONPATH=\r\nset {{ env_prefix }}_EDGE_HOME={home}\r\n'
                            f'"{py}" -m {{ package_name }}.edge.start {flag}--port {PORT} %*\r\n')
        else:
            bin_dir = Path.home() / ".local" / "bin"
            bin_dir.mkdir(parents=True, exist_ok=True)
            path = bin_dir / f"{{ tool_name }}-start{mode}"
            path.write_text(f'#!/bin/sh\nunset PYTHONPATH\nexport {{ env_prefix }}_EDGE_HOME="{home}"\n'
                            f'exec "{py}" -m {{ package_name }}.edge.start {flag}--port {PORT} "$@"\n')
            path.chmod(0o755)
        starts[mode] = path

    log = open(home / "edge.log", "ab")
    kw = {"creationflags": 0x00000008 | 0x00000200} if sys.platform == "win32" else {"start_new_session": True}
    subprocess.Popen([str(py), "-m", "{{ package_name }}.edge.start", *(["--lan"] if LAN else []), "--port", str(PORT)],
                     stdout=log, stderr=log, stdin=subprocess.DEVNULL,
                     env={**clean, "{{ env_prefix }}_EDGE_HOME": str(home)}, **kw)
    for _ in range(30):
        time.sleep(1)
        if running():
            break
    say(f"  ok started ({WHERE})")
    url = f"http://127.0.0.1:{PORT}/"
    if os.environ.get("DISPLAY") or sys.platform in ("win32", "darwin"):
        webbrowser.open(url)

    say("")
    say(f"Next, in the edge ({url}):")
    say("  1. Connections: + Add connection, with the edge API address from the cloud's About page")
    say("  2. Let an admin of your {{ tenant_noun }} approve the code on the cloud's /link page")
    say("")
    say("Start it again later with:")
    say(f"  {starts['']}        this computer only")
    say(f"  {starts['-lan']}    this computer and its network: the address for other")
    say(f"      computers is in {home / 'edge.log'}, and the chat key in the chat panel")


if __name__ == "__main__":
    main()
