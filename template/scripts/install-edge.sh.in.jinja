#
# Install {{ title }} @VERSION@ on this PC (Linux or macOS).
#
# Download this script and the package next to it from {{ cloud_name }}
# (Settings → Edges → Install an edge), then run:
#
#     bash install-{{ tool_name }}.sh
#
# What it does, and nothing else:
#   1. checks for Python 3.10 or newer (with its venv module)
#   2. checks the package against the SHA-256 {{ cloud_name }} published
#   3. installs it into its own folder, ~/.local/share/{{ tool_name }}
#      (owner-only), with a virtualenv: nothing system-wide, no sudo
#   4. adds two start commands to ~/.local/bin and starts the first:
#        {{ tool_name }}-start       http://127.0.0.1:{{ port }}, this PC only
#        {{ tool_name }}-start-lan   this PC and its network: other computers
#                                  open the page; the chat needs its key there
#      ({{ env_prefix }}_EDGE_PORT to change the port; {{ env_prefix }}_EDGE_LAN=1 starts
#      the second one now). Each stops a running edge first, so switching is
#      running the other one.
# Running it again updates the edge and keeps its catalog.
#
# Generated by scripts/publish-to-cloud.sh; do not edit the copy in the cloud.
set -euo pipefail

VERSION="@VERSION@"
WHEEL="@WHEEL@"
SHA256="@SHA256@"
HERE="$(cd "$(dirname "$0")" && pwd)"
HOME_DIR="{{ "${" ~ env_prefix }}_EDGE_HOME:-$HOME/.local/share/{{ tool_name }}}"
BIN="$HOME/.local/bin"
PORT="{{ "${" ~ env_prefix }}_EDGE_PORT:-{{ port }}}"
case "{{ "${" ~ env_prefix }}_EDGE_LAN:-0}" in
  1|yes|true) START="{{ tool_name }}-start-lan"; WHERE="this PC and its network" ;;
  *)          START="{{ tool_name }}-start";     WHERE="this PC only" ;;
esac
say() { printf '%s\n' "$*"; }
stop() { say ""; say "  ✗ $*"; exit 1; }

say "{{ title }} $VERSION"

# 1. Python
PY=""
for c in python3.13 python3.12 python3.11 python3.10 python3; do
  if command -v "$c" >/dev/null 2>&1 && "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
    PY="$(command -v "$c")"; break
  fi
done
[ -n "$PY" ] || stop "Python 3.10 or newer is needed. Ubuntu/Debian: sudo apt install python3 python3-venv · macOS: https://www.python.org/downloads/"
"$PY" -c 'import venv, ensurepip' 2>/dev/null || stop "Python's venv module is missing. Ubuntu/Debian: sudo apt install python3-venv"
say "  ✓ $("$PY" --version) at $PY"

# 2. the package, checked
PKG="$HERE/$WHEEL"
[ -f "$PKG" ] || stop "$WHEEL must be next to this script: download both from {{ cloud_name }}."
if command -v sha256sum >/dev/null 2>&1; then GOT="$(sha256sum "$PKG" | cut -d' ' -f1)"; else GOT="$(shasum -a 256 "$PKG" | cut -d' ' -f1)"; fi
[ "$GOT" = "$SHA256" ] || stop "$WHEEL does not match its checksum. Download it again from {{ cloud_name }}."
say "  ✓ package checked (SHA-256)"

# 3. its own folder and virtualenv
unset PYTHONPATH                        # a ROS or other PYTHONPATH must not shadow the venv
mkdir -p "$HOME_DIR"
chmod 700 "$HOME_DIR"
[ -x "$HOME_DIR/venv/bin/python" ] || "$PY" -m venv "$HOME_DIR/venv"
"$HOME_DIR/venv/bin/python" -m pip install --quiet --upgrade pip
say "  … installing (the first time this downloads its libraries, a few minutes)"
"$HOME_DIR/venv/bin/python" -m pip install --quiet --upgrade --force-reinstall --no-deps "$PKG"
"$HOME_DIR/venv/bin/python" -m pip install --quiet "$PKG"
say "  ✓ installed in $HOME_DIR"

# 4. two start commands, and start one; each stops a running edge first
# (a restart from the page would keep the old mode)
mkdir -p "$BIN"
write_start() {  # name, flag, where
  cat > "$BIN/$1" <<EOF
#!/usr/bin/env bash
# Start {{ title }} on port $PORT, $3 (installed by install-{{ tool_name }}.sh)
unset PYTHONPATH
export {{ env_prefix }}_EDGE_HOME="$HOME_DIR"
exec "$HOME_DIR/venv/bin/python" -m {{ package_name }}.edge.start $2--port $PORT "\$@"
EOF
  chmod 755 "$BIN/$1"
}
write_start "{{ tool_name }}-start" "" "this PC only"
write_start "{{ tool_name }}-start-lan" "--lan " "this PC and its network"

nohup "$BIN/$START" > "$HOME_DIR/edge.log" 2>&1 &
for _ in $(seq 1 20); do curl -s -o /dev/null http://127.0.0.1:$PORT/api/health 2>/dev/null && break; sleep 1; done
say "  ✓ started ($WHERE)"
URL="http://127.0.0.1:$PORT/"
if command -v xdg-open >/dev/null 2>&1; then xdg-open "$URL" >/dev/null 2>&1 || true
elif command -v open >/dev/null 2>&1; then open "$URL" || true; fi

say ""
say "Next, in the edge ($URL):"
say "  1. Connections: + Add connection, with the edge API address from the cloud's About page"
say "  2. Let an admin of your {{ tenant_noun }} approve the code on the cloud's /link page"
say ""
say "Start it again later with:"
say "  $BIN/{{ tool_name }}-start        this PC only"
say "  $BIN/{{ tool_name }}-start-lan    this PC and its network: the address for other computers"
say "                                 is in $HOME_DIR/edge.log, and the chat key in the chat panel"
